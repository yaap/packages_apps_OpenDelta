    <string name="action_secure_mode">Biztonság</string>
    <string name="secure_mode_enabled_title">Biztonságos mód: bekapcsolva</string>
    <string name="secure_mode_enabled_description"><![CDATA[A frissítés kriptográfiai aláírását a flashelés előtt ellenőrizzük, hogy megerősítsük a frissítés eredetét, és további frissítések nem kerülnek flashelésre. Ez a mód csak <b>TWRP</b>-vel kompatibilis.]]></string>
    <string name="secure_mode_disabled_title">Biztonságos mód: kikapcsolva</string>
    <string name="secure_mode_disabled_description"><![CDATA[További frissítések települhetnek, ha vannak. Vegye figyelembe, hogy bármely (rosszindulatú) szoftvercsomag elhelyezheti ezeket a frissítéseket, ezzel teljes rendszerelérést szerezve. Legyen óvatos.]]></string>
    <string name="recovery_notice_title">Figyelmeztetés</string>
    <string name="recovery_notice_description_not_secure"><![CDATA[A frissítések jelenlegi üzemmódban történő telepítése hivatalosan csak a <b>TWRP</b> recoveryk esetén támogatott. A <i>hivatalos</i> <b>CWM</b> recoveryk <i>nem</i> támogatottak, bár egyes <i>közösségi fejlesztésű</i> változatai még <i>talán</i> működhetnek. Kérjük, győződjön meg róla, hogy kompatibilis recoveryt futtat, mielőtt folytatná.]]></string>
    <string name="recovery_notice_description_reboot"><![CDATA[A készülék most újraindul az AOSP recoverybe, hogy telepítse a frissítést.]]></string>
